<Page
    x:Class="Launcher.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Launcher.App.Converters"
    xmlns:vm="using:Launcher.App.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

                <ProgressBar
                    AutomationProperties.Name="Scan progress"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Rescan installed apps"
                Command="{x:Bind ViewModel.RescanCommand}"
                Content="Rescan"
                IsEnabled="{x:Bind ViewModel.CanRescan, Mode=OneWay}" />
        </Grid>

        <!--
            A plain virtualized list, per SPEC.md Phase 2: "dump results to a plain list to
            prove it works". Phase 3 replaces it with the real tile grid.
        -->
        <ListView
            Grid.Row="1"
            AutomationProperties.Name="Discovered apps"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AppListItem">
                    <Grid Height="48" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="{x:Bind Icon}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Detail}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                            <Border
                                Padding="8,2"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind IsFiltered, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind FilteredLabel}" />
                            </Border>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SourceLabel}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="1"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

            <Border
                Width="88"
                Height="88"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="44">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE71D;" />
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="No apps found" />

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="Nothing turned up in the Start Menu or the package catalog. Try Rescan, or check the discovery sources in Settings."
                TextAlignment="Center" />
        </StackPanel>
    </Grid>

</Page>

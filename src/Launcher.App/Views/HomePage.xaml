<Page
    x:Class="Launcher.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Launcher.App.Converters"
    xmlns:vm="using:Launcher.App.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Launch failures surface here rather than as a dialog or a silent no-op. -->
        <InfoBar
            Grid.Row="0"
            Margin="0,0,0,12"
            IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.MessageBody, Mode=OneWay}"
            Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

                <ProgressBar
                    AutomationProperties.Name="Scan progress"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Rescan installed apps"
                Command="{x:Bind ViewModel.RescanCommand}"
                Content="Rescan"
                IsEnabled="{x:Bind ViewModel.CanRescan, Mode=OneWay}" />
        </Grid>

        <GridView
            x:Name="AppGrid"
            Grid.Row="2"
            AutomationProperties.Name="Apps"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind ViewModel.Items}"
            KeyDown="OnGridKeyDown"
            SelectionMode="Single">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:AppTileViewModel">
                    <Grid
                        Width="112"
                        Height="124"
                        Padding="8,10"
                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                        PointerEntered="OnTilePointerEntered"
                        PointerExited="OnTilePointerExited"
                        ToolTipService.ToolTip="{x:Bind Detail}">

                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind LaunchCommand}" Text="Launch">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind LaunchAsAdministratorCommand}"
                                    Text="Launch as administrator"
                                    Visibility="{x:Bind CanLaunchAsAdministrator, Converter={StaticResource BoolToVisibility}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7EF;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind OpenFileLocationCommand}"
                                    Text="Open file location"
                                    Visibility="{x:Bind CanOpenFileLocation, Converter={StaticResource BoolToVisibility}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem Command="{x:Bind RenameCommand}" Text="Rename">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem Command="{x:Bind ChangeIconCommand}" Text="Change icon">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE91B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind ResetIconCommand}"
                                    Text="Reset icon"
                                    Visibility="{x:Bind HasCustomIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                <MenuFlyoutItem
                                    Command="{x:Bind EditLaunchOptionsCommand}"
                                    Text="Edit launch options"
                                    Visibility="{x:Bind CanEditLaunchOptions, Converter={StaticResource BoolToVisibility}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    Command="{x:Bind ToggleFavoriteCommand}"
                                    Text="{x:Bind FavoriteMenuText, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE734;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind ToggleHiddenCommand}"
                                    Text="{x:Bind HideMenuText, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED1A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem Command="{x:Bind ShowPropertiesCommand}" Text="Properties">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <StackPanel VerticalAlignment="Top" Spacing="8">
                            <Image
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Source="{x:Bind Icon, Mode=OneWay}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                MaxLines="2"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <FontIcon
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="{x:Bind BadgeGlyph, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind BadgeTooltip, Mode=OneWay}"
                            Visibility="{x:Bind ShowBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE735;"
                            ToolTipService.ToolTip="Favorite"
                            Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            Kept transparent until the pointer is over the tile; the handlers
                            in code-behind fade it in. A visual state would need the template
                            root to be a control, which a DataTemplate root is not.
                        -->
                        <Button
                            x:Name="MoreButton"
                            Width="28"
                            Height="28"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="More options"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnMoreButtonClick"
                            Opacity="0">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel
            Grid.Row="2"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

            <Border
                Width="88"
                Height="88"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="44">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE71D;" />
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="No apps found" />

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="Nothing turned up in the Start Menu or the package catalog. Try Rescan, or check the discovery sources in Settings."
                TextAlignment="Center" />
        </StackPanel>
    </Grid>

</Page>

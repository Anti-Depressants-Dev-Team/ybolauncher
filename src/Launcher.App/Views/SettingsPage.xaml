<Page
    x:Class="Launcher.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageContentMargin}" Spacing="4">

            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />

            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="Discovery sources, hotkeys, tray behaviour and the rest arrive with their phases." />

            <TextBlock
                Margin="0,8,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Appearance" />

            <tk:SettingsCard
                Description="Choose a light or dark theme, or follow the Windows setting."
                Header="App theme">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>

                <ComboBox
                    x:Name="ThemeCombo"
                    MinWidth="160"
                    AutomationProperties.Name="App theme"
                    SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Use system setting" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Mica Alt is slightly darker and tints more strongly toward the desktop wallpaper."
                Header="Window backdrop">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81E;" />
                </tk:SettingsCard.HeaderIcon>

                <ComboBox
                    x:Name="BackdropCombo"
                    MinWidth="160"
                    AutomationProperties.Name="Window backdrop"
                    SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Mica" />
                    <ComboBoxItem Content="Mica Alt" />
                </ComboBox>
            </tk:SettingsCard>

            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Discovery" />

            <tk:SettingsCard
                Description="Scan the machine and user Start Menu folders for shortcuts."
                Header="Start Menu shortcuts">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8FD;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Scan Start Menu shortcuts"
                    IsOn="{x:Bind ViewModel.ScanStartMenu, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Scan the Store and MSIX package catalog."
                Header="Installed and Store apps">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Scan installed and Store apps"
                    IsOn="{x:Bind ViewModel.ScanPackagedApps, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Reveal uninstallers, documentation links and broken shortcuts. No rescan needed - they are always kept in the catalog."
                Header="Show filtered entries">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71C;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Show filtered entries"
                    IsOn="{x:Bind ViewModel.ShowFilteredEntries, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Bring back apps you hid from a tile's context menu, so you can unhide them."
                Header="Show hidden entries">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xED1A;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Show hidden entries"
                    IsOn="{x:Bind ViewModel.ShowHiddenEntries, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="{x:Bind ViewModel.IconCacheStatus, Mode=OneWay}"
                Header="Rescan and icon cache">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72C;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.Name="Clear the icon cache"
                        Command="{x:Bind ViewModel.ClearIconCacheCommand}"
                        Content="Clear icon cache" />
                    <Button
                        AutomationProperties.Name="Rescan installed apps"
                        Command="{x:Bind ViewModel.RescanCommand}"
                        Content="Rescan"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </tk:SettingsCard>

            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Storage" />

            <tk:SettingsExpander
                Description="{x:Bind ViewModel.StorageModeDescription}"
                Header="Where your layout is stored">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </tk:SettingsExpander.HeaderIcon>

                <Button
                    AutomationProperties.Name="Open the storage folder"
                    Command="{x:Bind ViewModel.OpenStorageFolderCommand}"
                    Content="Open folder" />

                <tk:SettingsExpander.Items>
                    <tk:SettingsCard
                        HorizontalContentAlignment="Left"
                        ContentAlignment="Left">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StorageLocation}"
                            TextWrapping="Wrap" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About" />

            <tk:SettingsCard
                Description="{x:Bind ViewModel.VersionDescription}"
                Header="YBO Launcher">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

        </StackPanel>
    </ScrollViewer>

</Page>

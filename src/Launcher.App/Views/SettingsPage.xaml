<Page
    x:Class="Launcher.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageContentMargin}" Spacing="4">

            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />

            <!--  Appearance  -->
            <TextBlock
                Margin="0,8,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Appearance" />

            <tk:SettingsCard
                Description="Choose a light or dark theme, or follow the Windows setting."
                Header="App theme">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="160"
                    AutomationProperties.Name="App theme"
                    SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Use system setting" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Mica Alt is slightly darker and tints more strongly toward the desktop wallpaper."
                Header="Window backdrop">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81E;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="160"
                    AutomationProperties.Name="Window backdrop"
                    SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Mica" />
                    <ComboBoxItem Content="Mica Alt" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Description="{x:Bind ViewModel.AccentDescription}" Header="Accent colour">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
                <Button
                    AutomationProperties.Name="Open Windows colour settings"
                    Command="{x:Bind ViewModel.OpenWindowsColorSettingsCommand}"
                    Content="Open Windows settings" />
            </tk:SettingsCard>

            <tk:SettingsExpander
                Description="Applies to tabs you create from now on. Each tab keeps its own view, which you can change from the view button next to the tab strip."
                Header="Default view for new tabs">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8A9;" />
                </tk:SettingsExpander.HeaderIcon>
                <ComboBox
                    MinWidth="160"
                    AutomationProperties.Name="Default view mode"
                    SelectedIndex="{x:Bind ViewModel.DefaultViewModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Large grid" />
                    <ComboBoxItem Content="Medium grid" />
                    <ComboBoxItem Content="Compact list" />
                </ComboBox>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Default tile size">
                        <Slider
                            Width="200"
                            AutomationProperties.Name="Default tile size"
                            Maximum="160"
                            Minimum="75"
                            StepFrequency="5"
                            Value="{x:Bind ViewModel.DefaultTileScalePercent, Mode=TwoWay}" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!--  Startup and window behaviour  -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Startup and window" />

            <tk:SettingsExpander Description="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" Header="Start with Windows">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </tk:SettingsExpander.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Start with Windows"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard
                        Description="Go straight to the notification area without showing the window."
                        Header="Start hidden in the tray">
                        <ToggleSwitch
                            AutomationProperties.Name="Start hidden in the tray"
                            IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsCard
                Description="The close button hides the window instead of quitting. Use Exit on the tray icon to quit."
                Header="Close to the notification area">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8BB;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Close to the notification area"
                    IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Get out of the way once you have started something."
                Header="Hide after launching an app">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E6;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Hide after launching an app"
                    IsOn="{x:Bind ViewModel.HideAfterLaunch, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsExpander Description="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}" Header="Global hotkey">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </tk:SettingsExpander.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Global hotkey"
                    IsOn="{x:Bind ViewModel.HotkeyEnabled, Mode=TwoWay}" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard
                        Description="Summons the launcher from anywhere, and hides it again."
                        Header="Key combination">
                        <Button
                            MinWidth="160"
                            AutomationProperties.Name="Change the global hotkey"
                            Command="{x:Bind ViewModel.ChangeHotkeyCommand}"
                            Content="{x:Bind ViewModel.HotkeyText, Mode=OneWay}" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!--  Discovery  -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Discovery" />

            <tk:SettingsCard
                Description="Scan the machine and user Start Menu folders for shortcuts."
                Header="Start Menu shortcuts">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8FD;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Scan Start Menu shortcuts"
                    IsOn="{x:Bind ViewModel.ScanStartMenu, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Scan the Store and MSIX package catalog."
                Header="Installed and Store apps">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Scan installed and Store apps"
                    IsOn="{x:Bind ViewModel.ScanPackagedApps, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Reveal uninstallers, documentation links and broken shortcuts. No rescan needed - they are always kept in the catalog."
                Header="Show filtered entries">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71C;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.Name="Show filtered entries"
                    IsOn="{x:Bind ViewModel.ShowFilteredEntries, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsExpander
                Description="Bring back apps you hid from a tile's context menu."
                Header="Hidden apps">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xED1A;" />
                </tk:SettingsExpander.HeaderIcon>
                <Button
                    AutomationProperties.Name="Manage hidden apps"
                    Command="{x:Bind ViewModel.ManageHiddenAppsCommand}"
                    Content="Manage" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard
                        Description="Shows every hidden app inline, where its context menu can unhide it."
                        Header="Show hidden entries on Home">
                        <ToggleSwitch
                            AutomationProperties.Name="Show hidden entries"
                            IsOn="{x:Bind ViewModel.ShowHiddenEntries, Mode=TwoWay}" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsCard
                Description="{x:Bind ViewModel.IconCacheStatus, Mode=OneWay}"
                Header="Rescan and icon cache">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72C;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.Name="Clear the icon cache"
                        Command="{x:Bind ViewModel.ClearIconCacheCommand}"
                        Content="Clear icon cache" />
                    <Button
                        AutomationProperties.Name="Rescan installed apps"
                        Command="{x:Bind ViewModel.RescanCommand}"
                        Content="Rescan"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </tk:SettingsCard>

            <!--  Storage  -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Storage" />

            <tk:SettingsExpander
                Description="{x:Bind ViewModel.StorageModeDescription}"
                Header="Where your layout is stored">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </tk:SettingsExpander.HeaderIcon>
                <Button
                    AutomationProperties.Name="Open the storage folder"
                    Command="{x:Bind ViewModel.OpenStorageFolderCommand}"
                    Content="Open folder" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard ContentAlignment="Left" HorizontalContentAlignment="Left">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StorageLocation}"
                            TextWrapping="Wrap" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsCard Description="{x:Bind ViewModel.ArchiveStatus, Mode=OneWay}" Header="Export and import">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B5;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.Name="Import a configuration archive"
                        Command="{x:Bind ViewModel.ImportConfigurationCommand}"
                        Content="Import..." />
                    <Button
                        AutomationProperties.Name="Export the configuration to a zip"
                        Command="{x:Bind ViewModel.ExportConfigurationCommand}"
                        Content="Export..." />
                </StackPanel>
            </tk:SettingsCard>

            <!--  About  -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About" />

            <tk:SettingsCard Description="{x:Bind ViewModel.VersionDescription}" Header="YBO Launcher">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <tk:SettingsCard
                Description="Puts every preference back to its default. Your tabs, your apps and the window position are left alone."
                Header="Reset settings">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE777;" />
                </tk:SettingsCard.HeaderIcon>
                <Button
                    AutomationProperties.Name="Reset settings to defaults"
                    Command="{x:Bind ViewModel.ResetToDefaultsCommand}"
                    Content="Reset" />
            </tk:SettingsCard>

        </StackPanel>
    </ScrollViewer>

</Page>

<winex:WindowEx
    x:Class="Launcher.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Launcher.App.Controls"
    xmlns:vm="using:Launcher.App.ViewModels"
    xmlns:winex="using:WinUIEx"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Custom title bar. The drag region is this whole grid; the search box is
            re-registered as a passthrough region in code-behind so it can take input.
        -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="{StaticResource TitleBarHeight}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- Space for the three system caption buttons (46px each at 100% scale).
                     A literal GridLength, not a StaticResource: ColumnDefinition.Width is
                     a GridLength and will not accept an x:Double. -->
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">

                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE71D;" />

                <TextBlock
                    x:Name="AppTitleText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            </StackPanel>

            <AutoSuggestBox
                x:Name="TitleBarSearchBox"
                Grid.Column="1"
                Width="420"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search apps"
                PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                QueryIcon="Find" />
        </Grid>

        <Grid Grid.Row="1">

            <!-- The tab surface. -->
            <Grid Visibility="{x:Bind ViewModel.TabsVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Launch and drop failures surface here, never as a dialog or a no-op. -->
                <InfoBar
                    Grid.Row="0"
                    Margin="12,4,12,0"
                    IsOpen="{x:Bind Library.IsMessageOpen, Mode=TwoWay}"
                    Message="{x:Bind Library.MessageBody, Mode=OneWay}"
                    Severity="{x:Bind Library.MessageSeverity, Mode=OneWay}"
                    Title="{x:Bind Library.MessageTitle, Mode=OneWay}" />

                <TabView
                    x:Name="Tabs"
                    Grid.Row="1"
                    AddTabButtonClick="OnAddTabClick"
                    CanReorderTabs="True"
                    IsAddTabButtonVisible="True"
                    SelectedItem="{x:Bind Library.SelectedTab, Mode=TwoWay}"
                    TabCloseRequested="OnTabCloseRequested"
                    TabItemsChanged="OnTabItemsChanged"
                    TabItemsSource="{x:Bind Library.Tabs}"
                    TabWidthMode="SizeToContent">

                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="vm:TabViewModel">
                            <TabViewItem
                                AllowDrop="True"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                DragOver="OnTabDragOver"
                                Drop="OnTabDrop"
                                Header="{x:Bind}"
                                IsClosable="{x:Bind CanClose}">

                                <TabViewItem.HeaderTemplate>
                                    <DataTemplate x:DataType="vm:TabViewModel">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">

                                            <TextBlock
                                                FontFamily="Segoe UI Emoji"
                                                Text="{x:Bind Glyph, Mode=OneWay}"
                                                Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />

                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />

                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Fill="{x:Bind AccentBrush, Mode=OneWay}"
                                                Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TabViewItem.HeaderTemplate>

                                <TabViewItem.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnEditTabClick" Text="Edit tab">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnDeleteTabClick" Text="Delete tab">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </TabViewItem.ContextFlyout>

                                <ctrl:AppGridView Margin="12,8,12,0" Tab="{x:Bind}" />
                            </TabViewItem>
                        </DataTemplate>
                    </TabView.TabItemTemplate>

                    <TabView.TabStripFooter>
                        <StackPanel
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">

                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind Library.IsScanning, Mode=OneWay}"
                                Visibility="{x:Bind Library.ScanningVisibility, Mode=OneWay}" />

                            <Button
                                AutomationProperties.Name="Rescan installed apps"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind Library.RescanCommand}"
                                IsEnabled="{x:Bind Library.CanRescan, Mode=OneWay}"
                                ToolTipService.ToolTip="Rescan installed apps">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>

                            <Button
                                AutomationProperties.Name="Settings"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                ToolTipService.ToolTip="Settings">
                                <FontIcon FontSize="14" Glyph="&#xE713;" />
                            </Button>
                        </StackPanel>
                    </TabView.TabStripFooter>
                </TabView>

                <TextBlock
                    Grid.Row="2"
                    Margin="16,4,16,8"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Library.StatusText, Mode=OneWay}" />
            </Grid>

            <!-- The Settings surface, swapped in over the tabs. -->
            <Grid Visibility="{x:Bind ViewModel.SettingsVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    Grid.Row="0"
                    Margin="16,4,0,0"
                    AutomationProperties.Name="Back to apps"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.CloseSettingsCommand}"
                    ToolTipService.ToolTip="Back to apps">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>

                <Frame x:Name="SettingsFrame" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>

</winex:WindowEx>

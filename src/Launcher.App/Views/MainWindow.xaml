<winex:WindowEx
    x:Class="Launcher.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Launcher.App.Controls"
    xmlns:tray="using:H.NotifyIcon"
    xmlns:vm="using:Launcher.App.ViewModels"
    xmlns:winex="using:WinUIEx"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid" CharacterReceived="OnCharacterReceived">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Invoked="OnFocusSearchRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="K" Invoked="OnFocusSearchRequested" Modifiers="Control" />

            <KeyboardAccelerator Key="Tab" Invoked="OnNextTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Tab" Invoked="OnPreviousTabRequested" Modifiers="Control,Shift" />

            <!-- Ctrl+1..9 jump straight to a tab; 9 is the last tab, not the ninth. -->
            <KeyboardAccelerator Key="Number1" Invoked="OnJumpToTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Number2" Invoked="OnJumpToTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Number3" Invoked="OnJumpToTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Number4" Invoked="OnJumpToTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Number5" Invoked="OnJumpToTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Number6" Invoked="OnJumpToTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Number7" Invoked="OnJumpToTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Number8" Invoked="OnJumpToTabRequested" Modifiers="Control" />
            <KeyboardAccelerator Key="Number9" Invoked="OnJumpToTabRequested" Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Lives in the window's tree so its context menu inherits a XamlRoot. Renders
            nothing itself.
        -->
        <tray:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/AppIcon.ico"
            LeftClickCommand="{x:Bind ViewModel.ToggleWindowCommand}"
            NoLeftClickDelay="True"
            ToolTipText="YBO Launcher">

            <tray:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Click="OnTrayShow" Text="Show">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7C4;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="OnTrayRescan" Text="Rescan">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="OnTraySettings" Text="Settings">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnTrayExit" Text="Exit">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tray:TaskbarIcon.ContextFlyout>
        </tray:TaskbarIcon>

        <!--
            Custom title bar. The drag region is this whole grid; the search box is
            re-registered as a passthrough region in code-behind so it can take input.
        -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="{StaticResource TitleBarHeight}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- Space for the three system caption buttons (46px each at 100% scale).
                     A literal GridLength, not a StaticResource: ColumnDefinition.Width is
                     a GridLength and will not accept an x:Double. -->
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">

                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE71D;" />

                <TextBlock
                    x:Name="AppTitleText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            </StackPanel>

            <!--
                A plain TextBox rather than AutoSuggestBox: AutoSuggestBox consumes Enter,
                Escape and the arrow keys for its own suggestion list, and SPEC.md gives
                all four of those jobs to the results list instead.
            -->
            <Grid
                Grid.Column="1"
                Width="420"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBox
                    x:Name="TitleBarSearchBox"
                    Padding="12,5,36,6"
                    AutomationProperties.Name="Search apps"
                    PreviewKeyDown="OnSearchBoxKeyDown"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    TextChanged="OnSearchTextChanged" />

                <FontIcon
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">

            <!-- The tab surface. -->
            <Grid Visibility="{x:Bind ViewModel.TabsVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Launch and drop failures surface here, never as a dialog or a no-op. -->
                <InfoBar
                    Grid.Row="0"
                    Margin="12,4,12,0"
                    IsOpen="{x:Bind Library.IsMessageOpen, Mode=TwoWay}"
                    Message="{x:Bind Library.MessageBody, Mode=OneWay}"
                    Severity="{x:Bind Library.MessageSeverity, Mode=OneWay}"
                    Title="{x:Bind Library.MessageTitle, Mode=OneWay}" />

                <TabView
                    x:Name="Tabs"
                    Grid.Row="1"
                    AddTabButtonClick="OnAddTabClick"
                    CanReorderTabs="True"
                    IsAddTabButtonVisible="True"
                    SelectedItem="{x:Bind Library.SelectedTab, Mode=TwoWay}"
                    TabCloseRequested="OnTabCloseRequested"
                    TabItemsChanged="OnTabItemsChanged"
                    TabItemsSource="{x:Bind Library.Tabs}"
                    TabWidthMode="SizeToContent"
                    Visibility="{x:Bind Library.TabContentVisibility, Mode=OneWay}">

                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="vm:TabViewModel">
                            <TabViewItem
                                AllowDrop="True"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                DragOver="OnTabDragOver"
                                Drop="OnTabDrop"
                                Header="{x:Bind}"
                                IsClosable="{x:Bind CanClose}">

                                <TabViewItem.HeaderTemplate>
                                    <DataTemplate x:DataType="vm:TabViewModel">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">

                                            <TextBlock
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                Text="{x:Bind Glyph, Mode=OneWay}"
                                                Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />

                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />

                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Fill="{x:Bind AccentBrush, Mode=OneWay}"
                                                Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TabViewItem.HeaderTemplate>

                                <TabViewItem.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnEditTabClick" Text="Edit tab">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnDeleteTabClick" Text="Delete tab">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </TabViewItem.ContextFlyout>

                                <ctrl:AppGridView Margin="12,8,12,0" Tab="{x:Bind}" />
                            </TabViewItem>
                        </DataTemplate>
                    </TabView.TabItemTemplate>

                    <TabView.TabStripFooter>
                        <StackPanel
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">

                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind Library.IsScanning, Mode=OneWay}"
                                Visibility="{x:Bind Library.ScanningVisibility, Mode=OneWay}" />

                            <Button
                                AutomationProperties.Name="View and sort options"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="View and sort options">
                                <FontIcon FontSize="14" Glyph="&#xE8A9;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Width="248" Spacing="8">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="View" />

                                            <RadioButtons
                                                AutomationProperties.Name="View mode"
                                                SelectedIndex="{x:Bind Library.ViewModeIndex, Mode=TwoWay}">
                                                <x:String>Large grid</x:String>
                                                <x:String>Medium grid</x:String>
                                                <x:String>Compact list</x:String>
                                            </RadioButtons>

                                            <TextBlock
                                                Margin="0,8,0,0"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="Tile size" />

                                            <Slider
                                                AutomationProperties.Name="Tile size"
                                                Maximum="160"
                                                Minimum="75"
                                                StepFrequency="5"
                                                Value="{x:Bind Library.TileScalePercent, Mode=TwoWay}" />

                                            <TextBlock
                                                Margin="0,8,0,0"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="Sort by" />

                                            <RadioButtons
                                                AutomationProperties.Name="Sort order"
                                                SelectedIndex="{x:Bind Library.SortModeIndex, Mode=TwoWay}">
                                                <x:String>Manual (drag order)</x:String>
                                                <x:String>Name (A to Z)</x:String>
                                                <x:String>Most used</x:String>
                                                <x:String>Recently used</x:String>
                                            </RadioButtons>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button
                                AutomationProperties.Name="Rescan installed apps"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind Library.RescanCommand}"
                                IsEnabled="{x:Bind Library.CanRescan, Mode=OneWay}"
                                ToolTipService.ToolTip="Rescan installed apps">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>

                            <Button
                                AutomationProperties.Name="Settings"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                ToolTipService.ToolTip="Settings">
                                <FontIcon FontSize="14" Glyph="&#xE713;" />
                            </Button>
                        </StackPanel>
                    </TabView.TabStripFooter>
                </TabView>

                <!-- Replaces the tab surface while a query is active; Esc returns. -->
                <ctrl:SearchResultsView
                    Grid.Row="1"
                    Visibility="{x:Bind Library.SearchVisibility, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    Margin="16,4,16,8"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Library.StatusText, Mode=OneWay}" />
            </Grid>

            <!-- The Settings surface, swapped in over the tabs. -->
            <Grid Visibility="{x:Bind ViewModel.SettingsVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    Grid.Row="0"
                    Margin="16,4,0,0"
                    AutomationProperties.Name="Back to apps"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.CloseSettingsCommand}"
                    ToolTipService.ToolTip="Back to apps">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>

                <Frame x:Name="SettingsFrame" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>

</winex:WindowEx>

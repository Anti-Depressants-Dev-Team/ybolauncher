<UserControl
    x:Class="Launcher.App.Controls.AppTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Launcher.App.Converters"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid
        x:Name="TileRoot"
        Width="{x:Bind Tile.Owner.TileWidth, Mode=OneWay}"
        Height="{x:Bind Tile.Owner.TileHeight, Mode=OneWay}"
        Padding="{x:Bind Tile.Owner.ItemPadding, Mode=OneWay}"
        AutomationProperties.Name="{x:Bind Tile.DisplayName, Mode=OneWay}"
        PointerEntered="OnPointerEnteredTile"
        PointerExited="OnPointerExitedTile"
        ToolTipService.ToolTip="{x:Bind Tile.Detail, Mode=OneWay}">

        <Grid.ContextFlyout>
            <MenuFlyout Opening="OnFlyoutOpening">
                <MenuFlyoutItem Command="{x:Bind Tile.LaunchCommand, Mode=OneWay}" Text="Launch">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    Command="{x:Bind Tile.LaunchAsAdministratorCommand, Mode=OneWay}"
                    Text="Launch as administrator"
                    Visibility="{x:Bind Tile.CanLaunchAsAdministrator, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE7EF;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    Command="{x:Bind Tile.OpenFileLocationCommand, Mode=OneWay}"
                    Text="Open file location"
                    Visibility="{x:Bind Tile.CanOpenFileLocation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutSeparator />

                <!-- Items are filled in by OnFlyoutOpening: the tab list is dynamic. -->
                <MenuFlyoutSubItem Tag="pin" Text="Pin to tab">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon Glyph="&#xE718;" />
                    </MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>

                <MenuFlyoutItem
                    Command="{x:Bind Tile.UnpinCommand, Mode=OneWay}"
                    Text="Remove from this tab"
                    Visibility="{x:Bind Tile.CanUnpin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE77A;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutSeparator />

                <MenuFlyoutItem Command="{x:Bind Tile.RenameCommand, Mode=OneWay}" Text="Rename">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem Command="{x:Bind Tile.ChangeIconCommand, Mode=OneWay}" Text="Change icon">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    Command="{x:Bind Tile.ResetIconCommand, Mode=OneWay}"
                    Text="Reset icon"
                    Visibility="{x:Bind Tile.HasCustomIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <MenuFlyoutItem
                    Command="{x:Bind Tile.EditLaunchOptionsCommand, Mode=OneWay}"
                    Text="Edit launch options"
                    Visibility="{x:Bind Tile.CanEditLaunchOptions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutSeparator />

                <MenuFlyoutItem
                    Command="{x:Bind Tile.ToggleFavoriteCommand, Mode=OneWay}"
                    Text="{x:Bind Tile.FavoriteMenuText, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    Command="{x:Bind Tile.ToggleHiddenCommand, Mode=OneWay}"
                    Text="{x:Bind Tile.HideMenuText, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xED1A;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutSeparator />

                <MenuFlyoutItem Command="{x:Bind Tile.ShowPropertiesCommand, Mode=OneWay}" Text="Properties">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <StackPanel
            VerticalAlignment="{x:Bind Tile.Owner.ContentAlignment, Mode=OneWay}"
            Orientation="{x:Bind Tile.Owner.ItemOrientation, Mode=OneWay}"
            Spacing="8">

            <Image
                x:Name="TileIcon"
                Width="{x:Bind Tile.Owner.IconSize, Mode=OneWay}"
                Height="{x:Bind Tile.Owner.IconSize, Mode=OneWay}"
                HorizontalAlignment="{x:Bind Tile.Owner.LabelAlignment, Mode=OneWay}"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Source="{x:Bind Tile.Icon, Mode=OneWay}" />

            <TextBlock
                HorizontalAlignment="{x:Bind Tile.Owner.LabelAlignment, Mode=OneWay}"
                VerticalAlignment="Center"
                MaxLines="{x:Bind Tile.Owner.LabelMaxLines, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Tile.DisplayName, Mode=OneWay}"
                TextAlignment="{x:Bind Tile.Owner.LabelTextAlignment, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </StackPanel>

        <FontIcon
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Glyph="{x:Bind Tile.BadgeGlyph, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Tile.BadgeTooltip, Mode=OneWay}"
            Visibility="{x:Bind Tile.ShowBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <FontIcon
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            FontSize="12"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Glyph="&#xE735;"
            ToolTipService.ToolTip="Favorite"
            Visibility="{x:Bind Tile.IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!--
            Transparent until the pointer is over the tile; the handlers in code-behind
            fade it in. A visual state would need the template root to be a control.
        -->
        <Button
            x:Name="MoreButton"
            Width="28"
            Height="28"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="More options"
            Background="Transparent"
            BorderThickness="0"
            Click="OnMoreButtonClick"
            Opacity="0">
            <FontIcon FontSize="14" Glyph="&#xE712;" />
        </Button>
    </Grid>

</UserControl>

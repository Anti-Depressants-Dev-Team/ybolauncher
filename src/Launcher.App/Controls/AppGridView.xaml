<UserControl
    x:Class="Launcher.App.Controls.AppGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Launcher.App.Converters"
    xmlns:vm="using:Launcher.App.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <GridView
            x:Name="Grid"
            AllowDrop="True"
            AutomationProperties.Name="Apps"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsStarting="OnDragItemsStarting"
            DragOver="OnDragOver"
            Drop="OnDrop"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            KeyDown="OnGridKeyDown"
            SelectionMode="Single">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:AppTileViewModel">
                    <Grid
                        Width="112"
                        Height="124"
                        Padding="8,10"
                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                        PointerEntered="OnTilePointerEntered"
                        PointerExited="OnTilePointerExited"
                        ToolTipService.ToolTip="{x:Bind Detail}">

                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="OnTileFlyoutOpening">
                                <MenuFlyoutItem Command="{x:Bind LaunchCommand}" Text="Launch">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind LaunchAsAdministratorCommand}"
                                    Text="Launch as administrator"
                                    Visibility="{x:Bind CanLaunchAsAdministrator, Converter={StaticResource BoolToVisibility}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7EF;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind OpenFileLocationCommand}"
                                    Text="Open file location"
                                    Visibility="{x:Bind CanOpenFileLocation, Converter={StaticResource BoolToVisibility}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <!-- Items are filled in by OnTileFlyoutOpening: the tab list is dynamic. -->
                                <MenuFlyoutSubItem Tag="pin" Text="Pin to tab">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE718;" />
                                    </MenuFlyoutSubItem.Icon>
                                </MenuFlyoutSubItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind UnpinCommand}"
                                    Text="Remove from this tab"
                                    Visibility="{x:Bind CanUnpin, Converter={StaticResource BoolToVisibility}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE77A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem Command="{x:Bind RenameCommand}" Text="Rename">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem Command="{x:Bind ChangeIconCommand}" Text="Change icon">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE91B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind ResetIconCommand}"
                                    Text="Reset icon"
                                    Visibility="{x:Bind HasCustomIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                <MenuFlyoutItem
                                    Command="{x:Bind EditLaunchOptionsCommand}"
                                    Text="Edit launch options"
                                    Visibility="{x:Bind CanEditLaunchOptions, Converter={StaticResource BoolToVisibility}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    Command="{x:Bind ToggleFavoriteCommand}"
                                    Text="{x:Bind FavoriteMenuText, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE734;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Command="{x:Bind ToggleHiddenCommand}"
                                    Text="{x:Bind HideMenuText, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED1A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem Command="{x:Bind ShowPropertiesCommand}" Text="Properties">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <StackPanel VerticalAlignment="Top" Spacing="8">
                            <Image
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Source="{x:Bind Icon, Mode=OneWay}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                MaxLines="2"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <FontIcon
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="{x:Bind BadgeGlyph, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind BadgeTooltip, Mode=OneWay}"
                            Visibility="{x:Bind ShowBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE735;"
                            ToolTipService.ToolTip="Favorite"
                            Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            Transparent until the pointer is over the tile; the handlers in
                            code-behind fade it in. A visual state would need the template
                            root to be a control, which a DataTemplate root is not.
                        -->
                        <Button
                            x:Name="MoreButton"
                            Width="28"
                            Height="28"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="More options"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnMoreButtonClick"
                            Opacity="0">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel
            x:Name="EmptyState"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">

            <Border
                Width="88"
                Height="88"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="44">
                <FontIcon
                    x:Name="EmptyStateGlyph"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE71D;" />
            </Border>

            <TextBlock
                x:Name="EmptyStateTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />

            <TextBlock
                x:Name="EmptyStateBody"
                HorizontalAlignment="Center"
                Style="{StaticResource PageSubtitleTextStyle}"
                TextAlignment="Center" />
        </StackPanel>
    </Grid>

</UserControl>

<UserControl
    x:Class="Launcher.App.Controls.AppGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Launcher.App.Controls"
    xmlns:vm="using:Launcher.App.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <!--
            Two controls rather than one with a swapped panel: a GridView wraps items and a
            ListView stacks them full width, and only the visible one realizes containers.
            Both share the same AppTile, so there is a single tile and menu definition.
        -->
        <GridView
            x:Name="TileGrid"
            AllowDrop="True"
            AutomationProperties.Name="Apps"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsStarting="OnDragItemsStarting"
            DragOver="OnDragOver"
            Drop="OnDrop"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            KeyDown="OnItemsKeyDown"
            SelectionMode="Single">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:AppTileViewModel">
                    <ctrl:AppTile Tile="{x:Bind}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ListView
            x:Name="CompactList"
            AllowDrop="True"
            AutomationProperties.Name="Apps"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsStarting="OnDragItemsStarting"
            DragOver="OnDragOver"
            Drop="OnDrop"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            KeyDown="OnItemsKeyDown"
            SelectionMode="Single"
            Visibility="Collapsed">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AppTileViewModel">
                    <ctrl:AppTile HorizontalAlignment="Stretch" Tile="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">

            <Border
                Width="88"
                Height="88"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="44">
                <FontIcon
                    x:Name="EmptyStateGlyph"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE71D;" />
            </Border>

            <TextBlock
                x:Name="EmptyStateTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />

            <TextBlock
                x:Name="EmptyStateBody"
                HorizontalAlignment="Center"
                Style="{StaticResource PageSubtitleTextStyle}"
                TextAlignment="Center" />

            <Button
                x:Name="EmptyStateAction"
                HorizontalAlignment="Center"
                AutomationProperties.Name="Go to the Home tab"
                Click="OnEmptyStateActionClick"
                Content="Go to Home"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>

</UserControl>

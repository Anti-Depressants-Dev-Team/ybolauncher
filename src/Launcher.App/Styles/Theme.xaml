<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Spacing scale (SPEC.md "Look and feel"): 4 / 8 / 12 / 16 / 24.
        Use these rather than ad-hoc margins so density stays consistent across pages.
    -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">12</x:Double>
    <x:Double x:Key="SpacingL">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>

    <Thickness x:Key="PageContentMargin">24,16,24,24</Thickness>
    <Thickness x:Key="StackGapS">0,8,0,0</Thickness>
    <Thickness x:Key="StackGapM">0,12,0,0</Thickness>

    <!-- Title bar is 48px to leave room for the search box without crowding it. -->
    <x:Double x:Key="TitleBarHeight">48</x:Double>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
